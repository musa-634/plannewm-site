---
// Unity Web ビルドを埋め込む。ページを開いたらすぐ読み込みを始める（Play ボタンは置かない）。
// スマホ非対応の作品をスマホで開いたときは、読み込まずに案内を出す。
interface Props {
  slug: string;
  title: string;
  buildName: string;
  mobile: boolean;
  aspect: string;
}
const { slug, title, buildName, mobile, aspect } = Astro.props;
const buildUrl = `/games/${slug}/Build`;
const [aw, ah] = aspect.split('/').map((s) => Number(s.trim()));
const ratio = aw && ah ? aw / ah : 16 / 9;
---

<div
  class="player"
  style={`aspect-ratio: ${aspect}; --ar: ${ratio};`}
  data-build-url={buildUrl}
  data-build-name={buildName}
  data-mobile={String(mobile)}
  data-title={title}
>
  <!-- Unity はキーボード入力の受け先を canvas の id で探すので、id は必須 -->
  <canvas id="unity-canvas" class="canvas" tabindex="-1"></canvas>

  <div class="overlay loading">
    <p class="loading-title">{title}</p>
    <div class="bar"><div class="fill"></div></div>
    <p class="pct">読み込み中 0%</p>
  </div>

  <div class="overlay gate" hidden>
    <p class="gate-title">この作品は PC ブラウザ向けです</p>
    <p class="gate-text">マウスとキーボードで遊ぶゲームです。<br />PC でこのページを開いてください。</p>
    <div class="gate-actions">
      <button type="button" class="btn copy">URL をコピー</button>
      <button type="button" class="btn ghost force">それでも試す</button>
    </div>
  </div>

  <div class="overlay error" hidden>
    <p class="gate-title">読み込みに失敗しました</p>
    <p class="gate-text error-text"></p>
  </div>
</div>

<div class="player-tools">
  <button type="button" class="btn ghost fullscreen" disabled>全画面</button>
</div>

<script>
  declare function createUnityInstance(
    canvas: HTMLCanvasElement,
    config: Record<string, unknown>,
    onProgress: (p: number) => void,
  ): Promise<{ SetFullscreen: (v: number) => void }>;

  const root = document.querySelector<HTMLElement>('.player');
  if (root) setup(root);

  function setup(root: HTMLElement) {
    const { buildUrl, buildName, title } = root.dataset;
    const supportsMobile = root.dataset.mobile === 'true';
    const canvas = root.querySelector<HTMLCanvasElement>('.canvas')!;
    const loading = root.querySelector<HTMLElement>('.loading')!;
    const fill = root.querySelector<HTMLElement>('.fill')!;
    const pct = root.querySelector<HTMLElement>('.pct')!;
    const gate = root.querySelector<HTMLElement>('.gate')!;
    const errorBox = root.querySelector<HTMLElement>('.error')!;
    const fullscreenBtn = document.querySelector<HTMLButtonElement>('.player-tools .fullscreen');

    const ua = navigator.userAgent;
    const isMobile =
      /iPhone|iPad|iPod|Android/i.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);

    if (isMobile && !supportsMobile) {
      loading.hidden = true;
      gate.hidden = false;
      gate.querySelector('.copy')?.addEventListener('click', async (e) => {
        const btn = e.currentTarget as HTMLButtonElement;
        try {
          await navigator.clipboard.writeText(location.href);
          btn.textContent = 'コピーしました';
        } catch {
          btn.textContent = location.href;
        }
      });
      gate.querySelector('.force')?.addEventListener('click', () => {
        gate.hidden = true;
        loading.hidden = false;
        start();
      });
      return;
    }
    start();

    function start() {
      const script = document.createElement('script');
      script.src = `${buildUrl}/${buildName}.loader.js`;
      script.onload = () => {
        createUnityInstance(
          canvas,
          {
            dataUrl: `${buildUrl}/${buildName}.data.unityweb`,
            frameworkUrl: `${buildUrl}/${buildName}.framework.js.unityweb`,
            codeUrl: `${buildUrl}/${buildName}.wasm.unityweb`,
            streamingAssetsUrl: 'StreamingAssets',
            companyName: 'PlanNewm',
            productName: title,
            productVersion: '1.0.0',
            // スマホでは解像度を下げて軽くする
            ...(isMobile ? { devicePixelRatio: 1 } : {}),
          },
          (p) => {
            const v = Math.round(p * 100);
            fill.style.width = `${v}%`;
            pct.textContent = `読み込み中 ${v}%`;
          },
        )
          .then((instance) => {
            loading.hidden = true;
            canvas.focus();
            if (fullscreenBtn) {
              fullscreenBtn.disabled = false;
              fullscreenBtn.addEventListener('click', () => instance.SetFullscreen(1));
            }
          })
          .catch((message) => showError(String(message)));
      };
      script.onerror = () => showError('ゲームのファイルが見つかりませんでした。');
      document.body.appendChild(script);
    }

    function showError(message: string) {
      loading.hidden = true;
      errorBox.hidden = false;
      errorBox.querySelector('.error-text')!.textContent = message;
    }
  }
</script>

<style>
  .player {
    position: relative;
    /* 画面の高さにも収まるよう、比率を保ったまま幅を決める */
    width: min(100%, calc((100svh - 140px) * var(--ar)));
    margin: 0 auto;
    background: #000;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
  }
  .canvas {
    display: block;
    width: 100%;
    height: 100%;
    outline: none;
  }
  .overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 16px;
    text-align: center;
    background: var(--bg);
  }
  .overlay[hidden] { display: none; }
  .loading-title {
    margin: 0;
    font-size: clamp(1.2rem, 4vw, 2.2rem);
    font-weight: 800;
    color: var(--accent);
  }
  .bar {
    width: min(360px, 70%);
    height: 6px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 3px;
    overflow: hidden;
  }
  .fill {
    width: 0;
    height: 100%;
    background: var(--accent);
    transition: width 0.2s;
  }
  .pct { margin: 0; color: var(--muted); font-size: 0.85rem; font-variant-numeric: tabular-nums; }
  .gate-title { margin: 0; font-weight: 800; font-size: 1.1rem; }
  .gate-text { margin: 0; color: var(--muted); font-size: 0.9rem; }
  .gate-actions { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }
  .player-tools { display: flex; justify-content: flex-end; margin-top: 8px; }
  .btn {
    font: inherit;
    font-size: 0.9rem;
    padding: 8px 16px;
    border-radius: 6px;
    border: 1px solid var(--accent);
    background: var(--accent);
    color: var(--bg);
    cursor: pointer;
  }
  .btn.ghost { background: transparent; color: var(--text); border-color: var(--line); }
  .btn:disabled { opacity: 0.4; cursor: default; }
</style>
