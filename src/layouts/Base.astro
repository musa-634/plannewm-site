---
interface Props {
  title?: string;
  description?: string;
  image?: string; // サイトからの絶対パス（例 /games/2026-11-22/card.png）
  themeStyle?: string; // 作品ページの CSS 変数上書き
  bodyClass?: string;
}

const SITE_NAME = 'PlanNewm';
const {
  title,
  description = '毎週ひとつ、ブラウザですぐ遊べるミニゲームを作っています。',
  image = '/og-default.png',
  themeStyle,
  bodyClass,
} = Astro.props;

const fullTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const site = Astro.site ?? new URL(Astro.url.origin);
const pageUrl = new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(image, site).href;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <slot name="head" />
  </head>
  <body class={bodyClass} style={themeStyle}>
    <header class="site-header">
      <a class="logo" href="/">PlanNewm</a>
      <nav><a href="/games/">作品</a></nav>
    </header>
    <slot />
    <footer class="site-footer">
      <span>PlanNewm</span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0b0b0d;
    --surface: #17171b;
    --line: #2a2a31;
    --text: #ececf1;
    --muted: #9a9aa6;
    --accent: #ffffff;
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: system-ui, -apple-system, 'Hiragino Sans', 'Yu Gothic UI', 'Meiryo', sans-serif;
    line-height: 1.7;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  a { color: var(--accent); }
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    max-width: 1280px;
    width: 100%;
    margin: 0 auto;
  }
  .site-header .logo {
    font-weight: 800;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--text);
  }
  .site-header nav a { color: var(--muted); text-decoration: none; font-size: 0.9rem; }
  .site-header nav a:hover { color: var(--text); }
  main { flex: 1; width: 100%; max-width: 1280px; margin: 0 auto; padding: 0 16px 48px; }
  .site-footer {
    color: var(--muted);
    font-size: 0.8rem;
    text-align: center;
    padding: 24px 16px;
    border-top: 1px solid var(--line);
  }
</style>
