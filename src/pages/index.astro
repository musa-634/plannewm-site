---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import GameGrid from '../components/GameGrid.astro';

const games = (await getCollection('games')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const [latest, ...rest] = games;
---

<Base>
  <main>
    <section class="hero">
      <p class="lead">毎週ひとつ、ブラウザですぐ遊べるミニゲームを作っています。</p>
    </section>

    {
      latest && (
        <section class="latest">
          <h2>最新作</h2>
          <a class="latest-card" href={`/games/${latest.id}/`}>
            <img src={`/games/${latest.id}/card.png`} alt="" width="1200" height="630" />
            <div>
              <p class="latest-title">{latest.data.title}</p>
              <p class="latest-summary">{latest.data.summary}</p>
              <span class="play">遊ぶ →</span>
            </div>
          </a>
        </section>
      )
    }

    {
      rest.length > 0 && (
        <section>
          <h2>これまでの作品</h2>
          <GameGrid games={rest} />
        </section>
      )
    }
  </main>
</Base>

<style>
  .hero { padding: 32px 0 16px; }
  .lead { margin: 0; color: var(--muted); }
  h2 { font-size: 0.9rem; color: var(--muted); font-weight: 600; letter-spacing: 0.08em; margin: 32px 0 12px; }
  .latest-card {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 24px;
    align-items: center;
    text-decoration: none;
    color: var(--text);
  }
  .latest-card img { width: 100%; height: auto; border-radius: 8px; border: 1px solid var(--line); }
  .latest-title { font-size: clamp(1.4rem, 4vw, 2rem); font-weight: 800; margin: 0 0 8px; }
  .latest-summary { margin: 0 0 16px; color: var(--muted); }
  .play {
    display: inline-block;
    padding: 8px 20px;
    border-radius: 6px;
    background: var(--text);
    color: var(--bg);
    font-weight: 700;
  }
  @media (max-width: 720px) {
    .latest-card { grid-template-columns: 1fr; gap: 12px; }
  }
</style>
