---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import UnityPlayer from '../../../components/UnityPlayer.astro';

export async function getStaticPaths() {
  const games = (await getCollection('games')).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
  return games.map((game, i) => ({
    params: { slug: game.id },
    props: { game, prev: games[i - 1], next: games[i + 1] },
  }));
}

const { game, prev, next } = Astro.props;
const { Content } = await render(game);
const d = game.data;
const t = d.theme;

// 作品ごとのデザイン（§4.6）：指定がなければ黒ベースのまま
const themeStyle = [
  t.bg && `--bg: ${t.bg}`,
  t.accent && `--accent: ${t.accent}`,
  t.text && `--text: ${t.text}`,
]
  .filter(Boolean)
  .join('; ');
const dateLabel = d.date.toISOString().slice(0, 10).replaceAll('-', '.');
---

<Base
  title={d.title}
  description={d.summary}
  image={`/games/${game.id}/card.png`}
  themeStyle={themeStyle}
  bodyClass={`game-page pattern-${t.pattern}`}
>
  <main>
    {
      d.playable ? (
        <UnityPlayer slug={game.id} title={d.title} buildName={d.buildName} mobile={d.mobile} aspect={d.aspect} />
      ) : (
        <img class="intro-image" src={`/games/${game.id}/card.png`} alt={d.title} />
      )
    }

    <section class="info">
      <p class="meta">
        {d.no !== undefined && <span>毎週ミニゲーム No.{String(d.no).padStart(2, '0')}</span>}
        <span>{dateLabel}</span>
        <span>{d.playable ? (d.mobile ? 'PC・スマホ' : 'PC ブラウザ向け') : '紹介のみ'}</span>
      </p>
      <h1>{d.title}</h1>
      <p class="summary">{d.summary}</p>
      {
        d.controls && (
          <div class="controls">
            <h2>操作</h2>
            <p>{d.controls}</p>
          </div>
        )
      }
      <div class="body">
        <Content />
      </div>
    </section>

    <nav class="pager">
      {prev ? <a href={`/games/${prev.id}/`}>← {prev.data.title}</a> : <span />}
      <a href="/games/">作品一覧</a>
      {next ? <a href={`/games/${next.id}/`}>{next.data.title} →</a> : <span />}
    </nav>
  </main>
</Base>

<style>
  .info { max-width: 760px; margin: 32px auto 0; }
  .meta { display: flex; gap: 12px; flex-wrap: wrap; margin: 0; color: var(--muted); font-size: 0.85rem; }
  h1 { margin: 4px 0 8px; font-size: clamp(1.6rem, 5vw, 2.4rem); line-height: 1.3; color: var(--accent); }
  .summary { margin: 0 0 24px; font-size: 1.05rem; }
  .controls { border: 1px solid var(--line); border-radius: 8px; padding: 12px 16px; margin-bottom: 24px; }
  .controls h2 { margin: 0 0 4px; font-size: 0.85rem; color: var(--muted); }
  .controls p { margin: 0; }
  .intro-image { display: block; width: 100%; max-width: 1200px; margin: 0 auto; border-radius: 8px; }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    max-width: 760px;
    margin: 48px auto 0;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
  }
  .pager a { color: var(--text); text-decoration: none; }
  .pager a:hover { color: var(--accent); }

  :global(body.game-page) { --line: color-mix(in srgb, var(--text) 18%, transparent); --muted: color-mix(in srgb, var(--text) 65%, transparent); }
  :global(body.pattern-grid) {
    background-image:
      linear-gradient(color-mix(in srgb, var(--text) 7%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--text) 7%, transparent) 1px, transparent 1px);
    background-size: 24px 24px;
  }
</style>
